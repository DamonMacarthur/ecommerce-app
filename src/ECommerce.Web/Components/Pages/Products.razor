@page "/products"
@using ECommerce.Web.Services
@inject CatalogApiClient Catalog
@inject OrderingApiClient Ordering
@rendermode InteractiveServer

<PageTitle>Catalog</PageTitle>

<h1>Catalog</h1>

@if (_products is null)
{
    <p><em>Loading products…</em></p>
}
else
{
    @* Explicit table roles keep the table semantics while rows are laid out as cards in a CSS grid. *@
    <table class="table product-grid" role="table">
        <thead role="rowgroup">
            <tr role="row">
                <th role="columnheader">Product</th>
                <th role="columnheader">Description</th>
                <th role="columnheader" class="text-end">Price</th>
                <th role="columnheader" class="text-end">Stock</th>
                <th role="columnheader"></th>
            </tr>
        </thead>
        <tbody role="rowgroup">
            @foreach (var p in _products)
            {
                <tr role="row" class="product-card">
                    <td role="cell" class="product-name" data-label="Product">@p.Name</td>
                    <td role="cell" class="product-description" data-label="Description">@p.Description</td>
                    <td role="cell" class="product-price" data-label="Price">
                        @if (p.CurrentPrice < p.Price)
                        {
                            <s class="text-muted">@p.Price.ToString("C")</s>
                            <strong>@p.CurrentPrice.ToString("C")</strong>
                            <span class="badge promo-badge">-@p.PromoPercent%</span>
                            <small class="text-muted d-block">until @p.PromoValidUntil?.ToString("d")</small>
                        }
                        else
                        {
                            @p.Price.ToString("C")
                        }
                    </td>
                    <td role="cell" class="product-stock" data-label="Stock">@p.AvailableStock</td>
                    <td role="cell" class="product-action">
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => AddToCart(p)">Add</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h2>Cart</h2>
    @if (_cart.Count == 0)
    {
        <p><em>Your cart is empty.</em></p>
    }
    else
    {
        <ul>
            @foreach (var line in _cart)
            {
                <li>@line.Value × @line.Key.Name (@line.Key.CurrentPrice.ToString("C"))</li>
            }
        </ul>

        <div class="mb-2">
            <label class="form-label">Customer name</label>
            <input class="form-control" style="max-width: 320px" @bind="_customer" />
        </div>
        <button class="btn btn-primary" @onclick="PlaceOrder" disabled="@_placing">Place order</button>
    }

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_isError ? "alert-danger" : "alert-success") mt-3">@_message</div>
    }
}

@code {
    private IReadOnlyList<ProductDto>? _products;
    private readonly Dictionary<ProductDto, int> _cart = new();
    private string _customer = "";
    private bool _placing;
    private string? _message;
    private bool _isError;

    protected override async Task OnInitializedAsync()
    {
        _products = await Catalog.GetProductsAsync();
    }

    private void AddToCart(ProductDto product)
    {
        _cart[product] = _cart.TryGetValue(product, out var qty) ? qty + 1 : 1;
        _message = null;
    }

    private async Task PlaceOrder()
    {
        if (string.IsNullOrWhiteSpace(_customer))
        {
            _message = "Please enter a customer name.";
            _isError = true;
            return;
        }

        _placing = true;
        var order = new CreateOrderDto(
            _customer,
            _cart.Select(c => new OrderLineDto(c.Key.Id, c.Value)).ToList());

        var (success, error) = await Ordering.CreateOrderAsync(order);
        _placing = false;

        if (success)
        {
            _message = "Order placed successfully!";
            _isError = false;
            _cart.Clear();
            _customer = "";
        }
        else
        {
            _message = $"Failed to place order: {error}";
            _isError = true;
        }
    }
}
