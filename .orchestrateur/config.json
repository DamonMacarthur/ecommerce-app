{
  "depot": "",
  "brancheParDefaut": "main",
  "regles": ".orchestrateur/code-health-rules.json",
  "build": "dotnet build ECommerce.slnx",
  "tests": "dotnet test ECommerce.slnx",
  "routes": [
    {
      "agent": "ui-refonte",
      "motsCles": [
        "frontend",
        "interface",
        "UI",
        "Blazor",
        "CSS",
        "page"
      ],
      "branche": "feat/frontend",
      "basePR": "feat/postgresql-categories",
      "criteres": [
        "preuves/ui/criteres.md"
      ]
    },
    {
      "agent": "codescene-sante",
      "motsCles": [
        "santé du code",
        "code health",
        "CodeScene",
        "bloqueur",
        "complexité"
      ],
      "branche": "chore/code-health",
      "basePR": "feat/postgresql-categories",
      "baseAnalyse": "main"
    }
  ]
}
